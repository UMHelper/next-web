{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "next-web",
  "compatibility_date": "2024-12-30",
  "keep_vars": true, 
  "vars": {
    // CopilotKit runtime sends telemetry unless this is set.
    "COPILOTKIT_TELEMETRY_DISABLED": "true",
  },
  "upload_source_maps": true, 
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
    },
  },
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // The service should match the "name" of your worker
      "service": "next-web",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "next-web-inc-cache",
    },
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "next-web-tag-cache",
      "database_id": "1231c11a-ae06-4923-b8de-fbd04fcdfa97",
    },
  ],
  "images": {
    // Enable image optimization
    // see https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES",
  },
  "env": {
    "dev": {
      "name": "next-web-dev",
      "keep_vars": true,
      "upload_source_maps": true,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
        },
      },
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "vars": {
        "COPILOTKIT_TELEMETRY_DISABLED": "true",
        "AI_BASE_URL": "https://api.deepseek.com",
        "AI_MODEL": "deepseek-flash",
        "AI_THINKING": "off",
        "AI_MAX_OUTPUT_TOKENS": "400",
        "AI_TIMEOUT_MS": "30000",
        "AGENT_RATE_LIMIT_PER_HOUR": "30",
        "AGENT_RATE_LIMIT_PER_DAY": "80",
        "AGENT_MAX_TURNS_PER_CONVERSATION": "30",
        "AGENT_HISTORY_TURNS": "8",
        "PREVIEW_MODE": "1",
        "PREVIEW_DB_READONLY": "1",
        "ASSISTANT_ACCESS_OVERRIDE": "everyone",
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "next-web-dev",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
    },
    "preview": {
      "name": "next-web-preview",
      "keep_vars": true,
      "upload_source_maps": true,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
        },
      },
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "vars": {
        "COPILOTKIT_TELEMETRY_DISABLED": "true",
        "AI_BASE_URL": "https://api.deepseek.com",
        "AI_MODEL": "deepseek-flash",
        "AI_THINKING": "off",
        "AI_MAX_OUTPUT_TOKENS": "400",
        "AI_TIMEOUT_MS": "30000",
        "AGENT_RATE_LIMIT_PER_HOUR": "30",
        "AGENT_RATE_LIMIT_PER_DAY": "80",
        "AGENT_MAX_TURNS_PER_CONVERSATION": "30",
        "AGENT_HISTORY_TURNS": "8",
        "PREVIEW_MODE": "1",
        "PREVIEW_DB_READONLY": "1",
        "ASSISTANT_ACCESS_OVERRIDE": "everyone",
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "next-web-preview",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
    },
  },
}
