# Copy this file to .env.local before running the app.
# Do not put production keys in this file.
# For local Supabase:
# 1. Run `supabase start` or `npx supabase start`
# 2. Copy the local API URL / publishable key / secret key from CLI output
# 3. Paste them into the placeholders below
# Local DB import uses:
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase local stack
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-supabase-publishable-key
SUPABASE_SECRET_KEY=your-local-supabase-secret-key

# Direct Postgres connection for migration / verification scripts (server-side only)
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# UM Open Data API（仅服务端使用，不能加 NEXT_PUBLIC_ 前缀）
UM_OPEN_DATA_TOKEN=

# App runtime
NEXT_PUBLIC_CURRENT_YEAR=2026
NEXT_PUBLIC_CURRENT_SEM=1
IS_PREENROLLMENT_OPEN=0

# 写接口限流（每小时）
RATE_LIMIT_COMMENT_PER_HOUR=10
RATE_LIMIT_REPLY_PER_HOUR=30
RATE_LIMIT_VOTE_PER_HOUR=120
RATE_LIMIT_REPORT_PER_HOUR=5

# iOS 客户端专用 API 认证(与 App 端 Secrets/UMSecrets.local 保持一致,勿提交真实值)
UM_IOS_API_SECRET=

# iOS 版本控制
# 留空 = 不启用服务端版本拦截；设置为语义化版本后，低于该版本的 iOS 请求返回 426。
UM_IOS_MIN_SUPPORTED_VERSION=
# 可选：客户端更新弹窗与 /api/version 返回的最新版本号。
UM_IOS_LATEST_VERSION=
# 可选：App Store 更新链接，例如 https://apps.apple.com/app/id1234567890
# 上架后替换为真实链接；留空时 iOS 端会回退到 App Store 首页。
UM_IOS_UPDATE_URL=

# Admin console: comma-separated Clerk user ids with platform-admin access
PLATFORM_ADMIN_USER_IDS=
# Optional: comma-separated verified Clerk email addresses with platform-admin access
PLATFORM_ADMIN_EMAILS=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# OpenAI plugin domain verification (portal-issued token; a Cloudflare secret in production)
OPENAI_APPS_CHALLENGE_TOKEN=

# AI 选课助手（仅服务端，禁止 NEXT_PUBLIC_ 前缀；线上 AI_API_KEY 用 wrangler secret put）
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
# off | low
AI_THINKING=off
AI_MAX_OUTPUT_TOKENS=400
AI_TIMEOUT_MS=30000
COPILOTKIT_TELEMETRY_DISABLED=true
AGENT_RATE_LIMIT_PER_HOUR=30
AGENT_RATE_LIMIT_PER_DAY=80
AGENT_MAX_TURNS_PER_CONVERSATION=30
AGENT_HISTORY_TURNS=8
# Dev/preview only: off | testers | everyone. Ignored unless PREVIEW_MODE=1; production reads
# app_config.ai_assistant_access instead.
ASSISTANT_ACCESS_OVERRIDE=

# Optional integrations
GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_SLOT_ID=
NEXT_PUBLIC_MEASUREMENT_ID=
IMGUR_CLIENT_ID=
IMGUR_CLIENT_SECRET=
BLOB_READ_WRITE_TOKEN=

# Telegram 举报机器人(仅服务端使用,勿暴露到客户端)
# 获取群组 ID 见 docs/telegram-report-setup.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_REPORT_CHAT_ID=
# 可选:论坛群组的话题 ID(message_thread_id)
TELEGRAM_REPORT_THREAD_ID=
# 可选:自定义 Telegram API 反向代理地址(默认 https://api.telegram.org)
TELEGRAM_API_BASE_URL=

# Informational
NEXT_PUBLIC_DATABASE_LAST_UPDATE=2026-08-15

# Dev/preview workers (next-web-dev / next-web-preview). Put build-time values in .env.dev.local /
# .env.preview.local (git-ignored), NOT in this file. See docs/preview-worker.md.
# Build-time (.env.dev.local / .env.preview.local):
#   NEXT_PUBLIC_SUPABASE_URL=<production url>
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<production publishable key>
#   SUPABASE_SECRET_KEY=<production secret key>
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<Clerk DEVELOPMENT key, must start with pk_test_>
#   PREVIEW_MODE=1
#   PREVIEW_DB_READONLY=1
# Runtime secrets (wrangler secret put <NAME> --env dev|preview):
#   AI_API_KEY, SUPABASE_SECRET_KEY, CLERK_SECRET_KEY (sk_test_...), PLATFORM_ADMIN_EMAILS
# PREVIEW_DB_READONLY=1 blocks every write to Supabase and swaps the rate limiter for an in-memory one.
# PREVIEW_MODE=1 enables ASSISTANT_ACCESS_OVERRIDE=off|testers|everyone (production DB lacks the column).
