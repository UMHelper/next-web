# Copy this file to .env.local before running the app.
# Do not put production keys in this file.
# For local Supabase:
# 1. Run `supabase start` or `npx supabase start`
# 2. Copy the local API URL / anon key / service_role key from CLI output
# 3. Paste them into the placeholders below
# Local DB import uses:
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase local stack
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-supabase-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-supabase-anon-key
SUPABASE_SECRET_KEY=your-local-supabase-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-local-supabase-service-role-key

# App runtime
NEXT_PUBLIC_CURRENT_YEAR=2026
NEXT_PUBLIC_CURRENT_SEM=1
IS_PREENROLLMENT_OPEN=0

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Optional integrations
GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_SLOT_ID=
NEXT_PUBLIC_MEASUREMENT_ID=
IMGUR_CLIENT_ID=
IMGUR_CLIENT_SECRET=
BLOB_READ_WRITE_TOKEN=

# Informational
NEXT_PUBLIC_DATABASE_LAST_UPDATE=2026-08-15
